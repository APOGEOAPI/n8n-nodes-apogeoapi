{
  "name": "n8n-nodes-apogeoapi",
  "version": "1.0.6",
  "description": "n8n community node for ApogeoAPI — IP geolocation, countries, cities, and exchange rates",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "geolocation",
    "ip",
    "countries",
    "exchange-rate",
    "currency",
    "cities",
    "states"
  ],
  "license": "MIT",
  "author": {
    "name": "ApogeoAPI",
    "email": "support@apogeoapi.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/APOGEOAPI/n8n-nodes-apogeoapi"
  },
  "homepage": "https://apogeoapi.com",
  "main": "index.js",
  "scripts": {
    "build": "tsc --project tsconfig.json && gulp build:icons",
    "dev": "tsc --project tsconfig.json --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build",
    "release": "npm version patch && git push && git push --tags"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ApogeoApiCredentials.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ApogeoAPI/ApogeoAPI.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.120.10",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
